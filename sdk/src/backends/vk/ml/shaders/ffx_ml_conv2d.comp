//
// Fused TOSA CONV2D -> RESCALE (-> TABLE) for int8 NHWC tensors.
//
// The conv input is a "virtual" tensor: the channel-wise CONCAT of up to two sources, each of which may be
// a nearest-neighbour TOSA RESIZE of a stored tensor. This lets the whole NSS U-Net run as one dispatch per conv.
//
// Exactly one of the following paths is compiled:
//   ML_PATH_COOPMAT  implicit GEMM on GL_KHR_cooperative_matrix (NVIDIA tensor cores, AMD WMMA, Intel XMX, ...).
//                    ML_MAT_INT8 / ML_MAT_FP16 / ML_MAT_BF16 selects the matrix element type (all exact for int8 data).
//   ML_PATH_DOT4     packed 4x8-bit integer dot products (GL_EXT_integer_dot_product).
//                    ML_DOT4_TILED=1 selects the register-tiled variant (PX pixels x OCB channels per thread, weights
//                    read with wave-uniform addresses so AMD fetches them through the scalar cache).
//   ML_PATH_SCALAR   plain 32-bit integer math, no optional device features required.
//
// All tensors are bound as uint32 arrays (4 int8 channels per word), so only the coop-matrix path needs
// 8/16-bit storage features.

#version 460
#extension GL_EXT_control_flow_attributes : require

#if ML_PATH_COOPMAT
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#if ML_MAT_INT8
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#define MAT_T  int8_t
#define VEC4_T i8vec4
#define ACC_T  int32_t
#define RAW_INPUT 1  // A holds raw int8 activations; the zero point is folded into the bias on the CPU
#elif ML_MAT_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define MAT_T  float16_t
#define VEC4_T f16vec4
#define ACC_T  float
#define RAW_INPUT 0
#elif ML_MAT_BF16
#extension GL_EXT_bfloat16 : require
#extension GL_EXT_shader_16bit_storage : require
#define MAT_T  bfloat16_t
#define VEC4_T bf16vec4
#define ACC_T  float
#define RAW_INPUT 0
#endif
#elif ML_PATH_DOT4
#extension GL_EXT_integer_dot_product : require
#if ML_DOT4_TILED
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif
#define RAW_INPUT 1
#else
#define RAW_INPUT 1
#endif

// ---------------------------------------------------------------------------------------------------------
// Specialization constants (set per layer and per vendor tuning)
// ---------------------------------------------------------------------------------------------------------
layout(constant_id = 0) const uint WG_SIZE = 128;  // threads per workgroup
#if ML_PATH_COOPMAT
layout(constant_id = 1) const uint TILE_M  = 16;   // coop-matrix M (pixels)
layout(constant_id = 2) const uint TILE_N  = 16;   // coop-matrix N (output channels)
layout(constant_id = 3) const uint TILE_K  = 32;   // coop-matrix K (input channels per step)
layout(constant_id = 4) const uint NUM_SG  = 4;    // subgroups per workgroup, each owns TILE_M pixels
layout(constant_id = 5) const uint NUM_NT  = 3;    // OC_PAD / TILE_N
layout(constant_id = 6) const uint OC_PAD  = 48;   // output channels padded to TILE_N
layout(constant_id = 7) const uint IC_PAD  = 32;   // input channels padded to TILE_K
layout(constant_id = 8) const uint TILE_ROWS = 2;  // output rows per subgroup
layout(constant_id = 9) const uint WEIGHTS_SHARED = 0;  // 1: the layer's weights are staged into shared memory
layout(constant_id = 52) const uint NT_PER_WG = 3;  // N tiles per workgroup; gl_WorkGroupID.z picks the group of N tiles
#endif

#if ML_DOT4_TILED
layout(constant_id = 53) const uint WG_Y = 1;   // workgroup rows (threads)
layout(constant_id = 54) const int  PX   = 4;   // output pixels per thread along x
layout(constant_id = 55) const int  OCB  = 16;  // output channels per thread (multiple of 4); gl_WorkGroupID.z picks the block
layout(constant_id = 61) const int  OC_FULL = 0;      // 1: OUT_C is a multiple of OCB (no padded channels in any block)
layout(constant_id = 59) const int  S0_ZP_PIXEL = 0;  // 1: source 0 has a zero-point pixel after its H x W pixels
layout(constant_id = 60) const int  S1_ZP_PIXEL = 0;
layout(constant_id = 56) const int  KSPLIT = 1;  // subgroups sharing the workgroup's output tiles (local z), each summing every KSPLIT-th input word
layout(local_size_x_id = 0, local_size_y_id = 53, local_size_z_id = 56) in;
#else
layout(local_size_x_id = 0) in;
#endif

// ---------------------------------------------------------------------------------------------------------
// Bindings
// ---------------------------------------------------------------------------------------------------------
layout(set = 0, binding = 0, std430) readonly buffer Src0 { uint src0[]; };
layout(set = 0, binding = 1, std430) readonly buffer Src1 { uint src1[]; };
#if ML_PATH_COOPMAT
layout(set = 0, binding = 2, std430) readonly buffer Weights { MAT_T weights[]; };  // [tap][IC_PAD][OC_PAD]
layout(set = 0, binding = 2, std430) readonly buffer WeightsVec { VEC4_T weightsVec[]; };  // same data, 4 per element
#else
layout(set = 0, binding = 2, std430) readonly buffer Weights { uint weights[]; };   // [OC][tap][IC_PAD/4] packed int8
#endif
// Per output channel: bias (zero-point folded for raw-input paths), multiplier, shift; then a 256 entry int8 table.
layout(set = 0, binding = 3, std430) readonly buffer Params { int params[]; };
layout(set = 0, binding = 4, std430) writeonly buffer Dst { uint dst[]; };

// Layer description, all specialization constants so the compiler can fold the address math.
layout(constant_id = 10) const int IN_H        = 1;   // virtual (post resize/concat) input height
layout(constant_id = 11) const int IN_W        = 1;
layout(constant_id = 12) const int OUT_H       = 1;
layout(constant_id = 13) const int OUT_W       = 1;
layout(constant_id = 14) const int OUT_C       = 4;   // real output channels
layout(constant_id = 15) const int OUT_STRIDE  = 4;   // stored output channels per pixel (multiple of 4)
layout(constant_id = 16) const int KERNEL_H    = 1;
layout(constant_id = 17) const int KERNEL_W    = 1;
layout(constant_id = 18) const int STRIDE_Y    = 1;
layout(constant_id = 19) const int STRIDE_X    = 1;
layout(constant_id = 20) const int PAD_TOP     = 0;
layout(constant_id = 21) const int PAD_LEFT    = 0;
layout(constant_id = 22) const int DILATION_Y  = 1;
layout(constant_id = 23) const int DILATION_X  = 1;
layout(constant_id = 24) const int INPUT_ZP    = 0;   // CONV2D input zero point
layout(constant_id = 25) const int IC_WORDS    = 1;   // padded input channels / 4
layout(constant_id = 26) const int RESCALE_IN_ZP  = 0;
layout(constant_id = 27) const int RESCALE_OUT_ZP = 0;
layout(constant_id = 28) const int FLAGS       = 0;   // bit0 double round, bit1 per channel, bit2 table
layout(constant_id = 29) const int NUM_SOURCES = 1;
// Source 0 / 1: stored tensor size, logical channels, stored channel stride and optional nearest RESIZE.
layout(constant_id = 30) const int S0_H = 1;
layout(constant_id = 31) const int S0_W = 1;
layout(constant_id = 32) const int S0_C = 4;
layout(constant_id = 33) const int S0_STRIDE = 4;
layout(constant_id = 34) const int S0_RESIZE = 0;
layout(constant_id = 35) const int S0_SCALE_Y_N = 1;
layout(constant_id = 36) const int S0_SCALE_Y_D = 1;
layout(constant_id = 37) const int S0_OFFSET_Y = 0;
layout(constant_id = 38) const int S0_SCALE_X_N = 1;
layout(constant_id = 39) const int S0_SCALE_X_D = 1;
layout(constant_id = 40) const int S0_OFFSET_X = 0;
layout(constant_id = 41) const int S1_H = 1;
layout(constant_id = 42) const int S1_W = 1;
layout(constant_id = 43) const int S1_C = 0;
layout(constant_id = 44) const int S1_STRIDE = 4;
layout(constant_id = 45) const int S1_RESIZE = 0;
layout(constant_id = 46) const int S1_SCALE_Y_N = 1;
layout(constant_id = 47) const int S1_SCALE_Y_D = 1;
layout(constant_id = 48) const int S1_OFFSET_Y = 0;
layout(constant_id = 49) const int S1_SCALE_X_N = 1;
layout(constant_id = 50) const int S1_SCALE_X_D = 1;
layout(constant_id = 51) const int S1_OFFSET_X = 0;

// 1: the host verified every shift is >= 33 and double rounding is off. The rounding constant then lies entirely in the
// high word of the 64-bit product, so (hi + 2^(shift-33)) >> (shift-32) is the exact TOSA result (no low word needed).
layout(constant_id = 58) const int SCALE_HI_ONLY = 0;

#define FLAG_DOUBLE_ROUND 1
#define FLAG_PER_CHANNEL  2
#define FLAG_TABLE        4

// Replicated zero-point word used for padding taps (each byte = inputZp).
uint ZpWord()
{
    uint b = uint(INPUT_ZP) & 0xFFu;
    return b | (b << 8) | (b << 16) | (b << 24);
}

int NearestCoord(int v, int scaleN, int scaleD, int offset, int size)
{
    // TOSA RESIZE (NEAREST_NEIGHBOR), integer form.
    int y  = v * scaleD + offset;
    int iy = y / scaleN;
    if (iy * scaleN > y)
        iy--;
    int ry = y - iy * scaleN;
    int i0 = max(iy, 0);
    int i1 = min(iy + 1, size - 1);
    return (2 * ry >= scaleN) ? i1 : i0;
}

// Fetch 4 consecutive channels (one packed word) of the virtual input at (vy, vx), channel c (multiple of 4).
uint FetchWord(int vy, int vx, int c)
{
    if (vy < 0 || vx < 0 || vy >= IN_H || vx >= IN_W)
        return ZpWord();

    if (c < S0_C)
    {
        int sy = vy, sx = vx;
        if (S0_RESIZE != 0)
        {
            sy = NearestCoord(vy, S0_SCALE_Y_N, S0_SCALE_Y_D, S0_OFFSET_Y, S0_H);
            sx = NearestCoord(vx, S0_SCALE_X_N, S0_SCALE_X_D, S0_OFFSET_X, S0_W);
        }
        return src0[((sy * S0_W + sx) * S0_STRIDE + c) >> 2];
    }
    c -= S0_C;
    if (NUM_SOURCES > 1 && c < S1_C)
    {
        int sy = vy, sx = vx;
        if (S1_RESIZE != 0)
        {
            sy = NearestCoord(vy, S1_SCALE_Y_N, S1_SCALE_Y_D, S1_OFFSET_Y, S1_H);
            sx = NearestCoord(vx, S1_SCALE_X_N, S1_SCALE_X_D, S1_OFFSET_X, S1_W);
        }
        return src1[((sy * S1_W + sx) * S1_STRIDE + c) >> 2];
    }
    // Channel padding: weights are zero there, any value works.
    return ZpWord();
}

// TOSA apply_scale_32 on a 32-bit value without requiring shaderInt64.
int ApplyScale32(int value, int multiplier, int shift, bool doubleRound)
{
    int  hi;
    int  lo;
    imulExtended(value, multiplier, hi, lo);
    uint ulo = uint(lo);
    uint uhi = uint(hi);

    // round = 1 << (shift - 1), plus +/- (1 << 30) for double rounding when shift > 31.
    uint rlo = 0u, rhi = 0u;
    if (shift - 1 < 32)
        rlo = 1u << uint(shift - 1);
    else
        rhi = 1u << uint(shift - 33);
    if (doubleRound && shift > 31)
    {
        if (hi >= 0)
        {
            uint carry;
            rlo = uaddCarry(rlo, 1u << 30, carry);
            rhi += carry;
        }
        else
        {
            // subtract 1<<30
            uint borrow;
            rlo = usubBorrow(rlo, 1u << 30, borrow);
            rhi -= borrow;
        }
    }

    uint carry;
    ulo = uaddCarry(ulo, rlo, carry);
    uhi = uhi + rhi + carry;

    // Arithmetic shift of the signed 64-bit value (uhi:ulo) right by shift, then truncate to 32 bits.
    if (shift >= 32)
        return int(uhi) >> (shift - 32);
    if (shift == 0)
        return int(ulo);
    return int((ulo >> uint(shift)) | (uhi << uint(32 - shift)));
}

// Params are laid out as [bias][multiplier][shift] each padded to a multiple of 4 entries, then the table.
int OC_PARAM_STRIDE()
{
    return (OUT_C + 3) & ~3;
}

#if ML_DOT4_TILED
// The 256-entry TABLE is copied to shared memory once per workgroup (one SSBO load per output value otherwise).
shared int sTable[64];
#endif

int TableLookup(int v)
{
    int index = v + 128;
#if ML_DOT4_TILED
    int word = sTable[index >> 2];
#else
    int word  = params[3 * OC_PARAM_STRIDE() + (index >> 2)];
#endif
    return bitfieldExtract(word, (index & 3) * 8, 8);
}

int Epilogue(int acc, int oc)
{
    int pIndex     = ((FLAGS & FLAG_PER_CHANNEL) != 0) ? oc : 0;
    int multiplier = params[OC_PARAM_STRIDE() + pIndex];
    int shift      = params[2 * OC_PARAM_STRIDE() + pIndex];
    int v;
    if (SCALE_HI_ONLY != 0)
    {
        int hi, lo;
        imulExtended(acc - RESCALE_IN_ZP, multiplier, hi, lo);
        v = (hi + (1 << (shift - 33))) >> (shift - 32);
    }
    else
        v = ApplyScale32(acc - RESCALE_IN_ZP, multiplier, shift, (FLAGS & FLAG_DOUBLE_ROUND) != 0);
    v              = clamp(v + RESCALE_OUT_ZP, -128, 127);
    if ((FLAGS & FLAG_TABLE) != 0)
        v = TableLookup(v);
    return v;
}

#if ML_DOT4_TILED
// Epilogue of the tiled kernel. With SCALE_HI_ONLY the output zero point is folded into the
// rounding constant: ((hi + r) >> k) + zp == (hi + r + (zp << k)) >> k for an arithmetic shift (|hi| < 2^30 and the
// constant < 2^25, no overflow), a per-channel uniform value.
int EpilogueBiased(int acc, int oc)
{
    if (SCALE_HI_ONLY == 0)
        return Epilogue(acc, oc);
    int pIndex     = ((FLAGS & FLAG_PER_CHANNEL) != 0) ? oc : 0;
    int multiplier = params[OC_PARAM_STRIDE() + pIndex];
    int shift      = params[2 * OC_PARAM_STRIDE() + pIndex];
    int hi, lo;
    imulExtended(acc - RESCALE_IN_ZP, multiplier, hi, lo);
    int v = clamp((hi + ((1 << (shift - 33)) + (RESCALE_OUT_ZP << (shift - 32)))) >> (shift - 32), -128, 127);
    if ((FLAGS & FLAG_TABLE) != 0)
        v = TableLookup(v);
    return v;
}
#endif

uint PackResult(ivec4 v)
{
    return (uint(v.x) & 0xFFu) | ((uint(v.y) & 0xFFu) << 8) | ((uint(v.z) & 0xFFu) << 16) | ((uint(v.w) & 0xFFu) << 24);
}

#if ML_PATH_COOPMAT
// ---------------------------------------------------------------------------------------------------------
// Cooperative-matrix implicit GEMM: M = pixels, N = output channels, K = taps x input channels.
//
// A workgroup owns a 2D output tile: TILE_M pixels wide (one coop-matrix row block) and NUM_SG * TILE_ROWS rows.
// The input patch the tile needs (with halo, after resize/concat/padding) is staged into shared memory once; every
// tap's A matrix is then read straight from the patch with coopMatLoad (row stride = STRIDE_X * IC_PAD), so the
// main loop has no barriers and no global loads besides the (cached) weights.
// ---------------------------------------------------------------------------------------------------------
const uint TILE_H   = NUM_SG * TILE_ROWS;
const uint PATCH_W  = (TILE_M - 1) * uint(STRIDE_X) + uint(KERNEL_W - 1) * uint(DILATION_X) + 1;
const uint PATCH_H  = (TILE_H - 1) * uint(STRIDE_Y) + uint(KERNEL_H - 1) * uint(DILATION_Y) + 1;

// Shared arrays use the matrix element type (coopMatLoad of vector-typed arrays is not portable); offsets and
// strides are in elements. Staging writes the four elements of each packed word.
const uint IC_VEC   = IC_PAD / 4;
const uint OC_VEC   = OC_PAD / 4;
const uint W_VEC    = WEIGHTS_SHARED != 0 ? uint(KERNEL_H * KERNEL_W) * IC_PAD * OC_VEC : 1;

shared MAT_T sPatch[PATCH_H * PATCH_W * IC_PAD];
shared MAT_T sW[W_VEC * 4];
shared ACC_T sC[NUM_SG * TILE_M * OC_PAD];

void Store4(uint index, VEC4_T v, bool weightsArray)
{
    if (weightsArray)
    {
        sW[index + 0] = v.x;
        sW[index + 1] = v.y;
        sW[index + 2] = v.z;
        sW[index + 3] = v.w;
    }
    else
    {
        sPatch[index + 0] = v.x;
        sPatch[index + 1] = v.y;
        sPatch[index + 2] = v.z;
        sPatch[index + 3] = v.w;
    }
}

VEC4_T ToMat(uint word)
{
#if ML_MAT_INT8
    return VEC4_T(unpack8(int(word)));
#else
    // Float paths consume (x - zp), which is exactly representable for int8 data.
    ivec4 v = ivec4(bitfieldExtract(int(word), 0, 8), bitfieldExtract(int(word), 8, 8), bitfieldExtract(int(word), 16, 8), bitfieldExtract(int(word), 24, 8)) - INPUT_ZP;
    return VEC4_T(vec4(v));
#endif
}

void main()
{
    const int  tileX0 = int(gl_WorkGroupID.x * TILE_M);
    const int  tileY0 = int(gl_WorkGroupID.y * TILE_H);
    const uint sg     = gl_SubgroupID;
    const uint ntBase = gl_WorkGroupID.z * NT_PER_WG;  // first output-channel tile of this workgroup

    // 1) Stage the input patch: PATCH_H x PATCH_W pixels x IC_PAD channels, one packed word (4 channels) per item.
    const uint wordsPerPixel = IC_PAD / 4;
    const uint patchWords    = PATCH_H * PATCH_W * wordsPerPixel;
    const int  inY0          = tileY0 * STRIDE_Y - PAD_TOP;
    const int  inX0          = tileX0 * STRIDE_X - PAD_LEFT;
    // All of a thread's global loads are issued before any shared store, so their latencies overlap.
    const uint STAGE_ITERS = (PATCH_H * PATCH_W * (IC_PAD / 4) + WG_SIZE - 1) / WG_SIZE;
    uint       staged[STAGE_ITERS];
    [[unroll]] for (uint k = 0; k < STAGE_ITERS; ++k)
    {
        const uint i = gl_LocalInvocationID.x + k * WG_SIZE;
        staged[k]    = 0u;
        if (i < patchWords)
        {
            const uint pixel = i / wordsPerPixel;
            const uint w     = i - pixel * wordsPerPixel;
            const uint py    = pixel / PATCH_W;
            const uint px    = pixel - py * PATCH_W;
            staged[k]        = FetchWord(inY0 + int(py), inX0 + int(px), int(w * 4));
        }
    }
    [[unroll]] for (uint k = 0; k < STAGE_ITERS; ++k)
    {
        const uint i = gl_LocalInvocationID.x + k * WG_SIZE;
        if (i < patchWords)
            Store4(i * 4, ToMat(staged[k]), false);
    }
    if (WEIGHTS_SHARED != 0)
    {
        for (uint i = gl_LocalInvocationID.x; i < W_VEC; i += WG_SIZE)
            Store4(i * 4, weightsVec[i], true);
    }
    barrier();

    // 2) Each subgroup computes TILE_ROWS rows of TILE_M pixels x NT_PER_WG * TILE_N channels.
    const int  numTaps = KERNEL_H * KERNEL_W;
    const uint kChunks = IC_PAD / TILE_K;
    const uint rowStride = uint(STRIDE_X) * IC_PAD;  // elements between neighbouring output pixels in the patch
    const uint wordBegin = ntBase * TILE_N / 4;
    const uint wordEnd   = min(uint(OUT_C + 3) / 4, (ntBase + NT_PER_WG) * TILE_N / 4);
    const uint outWords  = wordEnd - wordBegin;
    const uint cBase     = sg * TILE_M * OC_PAD;

    for (uint r = 0; r < TILE_ROWS; ++r)
    {
        const uint localRow = sg * TILE_ROWS + r;
        const int  oy       = tileY0 + int(localRow);
        if (oy >= OUT_H)
            break;

        coopmat<ACC_T, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> acc[NT_PER_WG];
        [[unroll]] for (uint nt = 0; nt < NT_PER_WG; ++nt)
            acc[nt] = coopmat<ACC_T, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(ACC_T(0));

        for (int tap = 0; tap < numTaps; ++tap)
        {
            const int  ky        = tap / KERNEL_W;
            const int  kx        = tap - ky * KERNEL_W;
            const uint patchBase = ((localRow * uint(STRIDE_Y) + uint(ky * DILATION_Y)) * PATCH_W + uint(kx * DILATION_X)) * IC_PAD;
            for (uint kc = 0; kc < kChunks; ++kc)
            {
                coopmat<MAT_T, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseA> a;
                coopMatLoad(a, sPatch, patchBase + kc * TILE_K, rowStride, gl_CooperativeMatrixLayoutRowMajor);

                const uint wBase = (uint(tap) * IC_PAD + kc * TILE_K) * OC_PAD + ntBase * TILE_N;
                [[unroll]] for (uint nt = 0; nt < NT_PER_WG; ++nt)
                {
                    coopmat<MAT_T, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseB> b;
                    if (WEIGHTS_SHARED != 0)
                        coopMatLoad(b, sW, wBase + nt * TILE_N, OC_PAD, gl_CooperativeMatrixLayoutRowMajor);
                    else
                        coopMatLoad(b, weights, wBase + nt * TILE_N, OC_PAD, gl_CooperativeMatrixLayoutRowMajor);
                    acc[nt] = coopMatMulAdd(a, b, acc[nt]);
                }
            }
        }

        // 3) Epilogue for this row, within the subgroup: accumulators -> shared -> rescale (+ table) -> packed int8.
        [[unroll]] for (uint nt = 0; nt < NT_PER_WG; ++nt)
            coopMatStore(acc[nt], sC, cBase + (ntBase + nt) * TILE_N, OC_PAD, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        for (uint i = gl_SubgroupInvocationID; i < TILE_M * outWords; i += gl_SubgroupSize)
        {
            const uint p  = i / outWords;
            const uint w  = wordBegin + i - p * outWords;
            const int  ox = tileX0 + int(p);
            if (ox >= OUT_W)
                continue;
            ivec4 res = ivec4(0);
            [[unroll]] for (uint j = 0; j < 4; ++j)
            {
                const int oc = int(w * 4 + j);
                if (oc < OUT_C)
                    res[j] = Epilogue(int(sC[cBase + p * OC_PAD + uint(oc)]) + params[oc], oc);
            }
            dst[((uint(oy) * uint(OUT_W) + uint(ox)) * uint(OUT_STRIDE) + w * 4) >> 2] = PackResult(res);
        }
        subgroupBarrier();
    }
}

#elif ML_DOT4_TILED
// ---------------------------------------------------------------------------------------------------------
// Register-tiled packed int8 conv. Each thread owns PX consecutive output pixels of one row and OCB output channels
// (the block gl_WorkGroupID.z). Per tap row and input word it loads the COLS input words its pixels need once and
// feeds each of them to up to PX * OCB dot4s. All threads of a workgroup share the output-channel block, so every
// weight address is uniform: on AMD those become scalar (s_buffer_load) reads and the dot4s take them as SGPR operands.
// Weights are laid out [ocBlock][tap][icWord][OCB] (zero padded) so one tap/word step reads OCB consecutive words.
// ---------------------------------------------------------------------------------------------------------
const int COLS = (PX - 1) * STRIDE_X + (KERNEL_W - 1) * DILATION_X + 1;
shared int sRed[KSPLIT > 1 ? KSPLIT * PX * OCB * int(WG_SIZE * WG_Y) : 1];  // KSPLIT partial sums

int Dot4(uint a, uint b)
{
    return dotPacked4x8EXT(int(a), int(b));
}

// acc[p][o] += x[p, kx] . w[kx][o] for the KERNEL_W taps of one kernel row and one input word; WB is the weight word of
// kx = 0. A macro, not a function: arrays sized by specialization constants do not survive being passed as parameters.
#define ACCUMULATE(WB)                                                                    \
    [[unroll]] for (int kx = 0; kx < KERNEL_W; ++kx)                                       \
    {                                                                                     \
        [[unroll]] for (int o = 0; o < OCB; ++o)                                          \
        {                                                                                 \
            const uint wv = weights[(WB) + kx * IC_WORDS * OCB + o];                       \
            [[unroll]] for (int p = 0; p < PX; ++p)                                       \
                acc[p * OCB + o] += Dot4(x[p * STRIDE_X + kx * DILATION_X], wv);          \
        }                                                                                 \
    }

void main()
{
    // KSPLIT > 1: the workgroup is KSPLIT subgroups (one per local z), all covering the same WG_SIZE x WG_Y tiles. The
    // host only uses it when one z slice is exactly one subgroup, so kp is subgroup-uniform; the broadcast tells the
    // compiler, which keeps the weight addresses scalar.
    const int kp      = KSPLIT > 1 ? int(subgroupBroadcastFirst(gl_LocalInvocationID.z)) : 0;
    const int ox0     = int(gl_GlobalInvocationID.x) * PX;
    const int oy      = int(gl_GlobalInvocationID.y);
    const int ocBlock = int(gl_WorkGroupID.z);
    const int cy      = min(oy, OUT_H - 1);  // out-of-range threads compute a valid row and skip the store
    const uint zp     = ZpWord();

    if ((FLAGS & FLAG_TABLE) != 0)
    {
        for (uint i = gl_LocalInvocationIndex; i < 64u; i += WG_SIZE * WG_Y * uint(KSPLIT))
            sTable[i] = params[3 * OC_PARAM_STRIDE() + int(i)];
        barrier();
    }

    int acc[PX * OCB];
    [[unroll]] for (int i = 0; i < PX * OCB; ++i)
        acc[i] = 0;

    const int wBlockBase = ocBlock * (KERNEL_H * KERNEL_W * IC_WORDS * OCB);
    const int s0Words    = S0_C / 4;

    for (int ky = 0; ky < KERNEL_H; ++ky)
    {
        const int  vy      = cy * STRIDE_Y - PAD_TOP + ky * DILATION_Y;
        const bool rowOk   = vy >= 0 && vy < IN_H;
        const int  vyc     = clamp(vy, 0, IN_H - 1);
        const int  sy0     = S0_RESIZE != 0 ? NearestCoord(vyc, S0_SCALE_Y_N, S0_SCALE_Y_D, S0_OFFSET_Y, S0_H) : vyc;
        const int  sy1     = S1_RESIZE != 0 ? NearestCoord(vyc, S1_SCALE_Y_N, S1_SCALE_Y_D, S1_OFFSET_Y, S1_H) : vyc;

        // Word address of every input column this thread touches (clamped in range; invalid taps select the zero point).
        int  base0[COLS];
        int  base1[COLS];
        bool valid[COLS];
        [[unroll]] for (int j = 0; j < COLS; ++j)
        {
            const int vx  = ox0 * STRIDE_X - PAD_LEFT + j;
            const int vxc = clamp(vx, 0, IN_W - 1);
            valid[j]      = rowOk && vx >= 0 && vx < IN_W;
            const int sx0 = S0_RESIZE != 0 ? NearestCoord(vxc, S0_SCALE_X_N, S0_SCALE_X_D, S0_OFFSET_X, S0_W) : vxc;
            base0[j]      = ((sy0 * S0_W + sx0) * S0_STRIDE) >> 2;
            // Padding taps read the zero-point pixel instead of selecting the zero point per word (one select per column).
            if (S0_ZP_PIXEL != 0)
                base0[j] = valid[j] ? base0[j] : ((S0_H * S0_W * S0_STRIDE) >> 2);
            if (NUM_SOURCES > 1)
            {
                const int sx1 = S1_RESIZE != 0 ? NearestCoord(vxc, S1_SCALE_X_N, S1_SCALE_X_D, S1_OFFSET_X, S1_W) : vxc;
                base1[j]      = ((sy1 * S1_W + sx1) * S1_STRIDE) >> 2;
                if (S1_ZP_PIXEL != 0)
                    base1[j] = valid[j] ? base1[j] : ((S1_H * S1_W * S1_STRIDE) >> 2);
            }
            else
                base1[j] = 0;
        }

        // Source 0 words, then source 1 words (concat). Words past the sources are channel padding with zero weights, so
        // they are skipped. Loads are unconditional (addresses are clamped in range) and selected afterwards, and the next
        // word is fetched before the current one is consumed so the load latency overlaps the dot4s. With KSPLIT > 1 this
        // lane only takes the words w = kp (mod KSPLIT).
        const int wRow  = wBlockBase + ky * KERNEL_W * IC_WORDS * OCB;
        const int s1End = NUM_SOURCES > 1 ? min(IC_WORDS, s0Words + (S1_C + 3) / 4) : s0Words;
        uint      xn[COLS];
        if (s0Words > 0)
        {
            [[unroll]] for (int j = 0; j < COLS; ++j)
                xn[j] = src0[base0[j] + min(kp, s0Words - 1)];
        }
        for (int w = kp; w < s0Words; w += KSPLIT)
        {
            uint x[COLS];
            [[unroll]] for (int j = 0; j < COLS; ++j)
                x[j] = (S0_ZP_PIXEL != 0 || valid[j]) ? xn[j] : zp;
            const int wn = min(w + KSPLIT, s0Words - 1);
            [[unroll]] for (int j = 0; j < COLS; ++j)
                xn[j] = src0[base0[j] + wn];
            ACCUMULATE(wRow + w * OCB)
        }
        if (NUM_SOURCES > 1 && s1End > s0Words)
        {
            const int w1 = s0Words + ((kp - s0Words) & (KSPLIT - 1));  // first word >= s0Words with w = kp (mod KSPLIT)
            [[unroll]] for (int j = 0; j < COLS; ++j)
                xn[j] = src1[base1[j] + min(w1, s1End - 1) - s0Words];
            for (int w = w1; w < s1End; w += KSPLIT)
            {
                uint x[COLS];
                [[unroll]] for (int j = 0; j < COLS; ++j)
                    x[j] = (S1_ZP_PIXEL != 0 || valid[j]) ? xn[j] : zp;
                const int wn = min(w + KSPLIT, s1End - 1) - s0Words;
                [[unroll]] for (int j = 0; j < COLS; ++j)
                    xn[j] = src1[base1[j] + wn];
                ACCUMULATE(wRow + w * OCB)
            }
        }
    }

    // KSPLIT > 1: every subgroup stores its partial sums to shared memory, then subgroup kp finishes the slice
    // [kp * FIN, (kp + 1) * FIN) of the flattened [PX][OCB] tile (exact integer adds) and runs the epilogue for it.
    const int FIN = (PX * OCB) / KSPLIT;  // finished sums per thread (multiple of 4)
    int       fin[FIN];
    if (KSPLIT > 1)
    {
        const uint tileThreads = WG_SIZE * WG_Y;
        const uint t           = gl_LocalInvocationID.y * WG_SIZE + gl_LocalInvocationID.x;
        [[unroll]] for (int i = 0; i < PX * OCB; ++i)
            sRed[(uint(kp * PX * OCB + i)) * tileThreads + t] = acc[i];
        barrier();
        [[unroll]] for (int i = 0; i < FIN; ++i)
        {
            int sum = 0;
            [[unroll]] for (int k = 0; k < KSPLIT; ++k)
                sum += sRed[uint(k * PX * OCB + kp * FIN + i) * tileThreads + t];
            fin[i] = sum;
        }
    }
    else
    {
        [[unroll]] for (int i = 0; i < FIN; ++i)
            fin[i] = acc[i];
    }

    if (oy >= OUT_H)
        return;
    [[unroll]] for (int q = 0; q < FIN / 4; ++q)
    {
        const int idx = kp * FIN + q * 4;  // flattened [PX][OCB] index; 4 consecutive channels of one pixel
        const int p   = idx / OCB;
        const int oc  = ocBlock * OCB + (idx - p * OCB);
        const int ox  = ox0 + p;
        if ((OC_FULL == 0 && oc >= OUT_C) || ox >= OUT_W)
            continue;
        ivec4 r = ivec4(0);
        [[unroll]] for (int j = 0; j < 4; ++j)
        {
            if (OC_FULL != 0 || oc + j < OUT_C)
                r[j] = EpilogueBiased(fin[q * 4 + j] + params[oc + j], oc + j);
        }
        dst[((oy * OUT_W + ox) * OUT_STRIDE + oc) >> 2] = PackResult(r);
    }
}

#else
// ---------------------------------------------------------------------------------------------------------
// One thread per (pixel, 4 output channels).
// ---------------------------------------------------------------------------------------------------------
int Dot4(uint a, uint b)
{
#if ML_PATH_DOT4
    return dotPacked4x8EXT(int(a), int(b));
#else
    int ia = int(a), ib = int(b);
    return bitfieldExtract(ia, 0, 8) * bitfieldExtract(ib, 0, 8) + bitfieldExtract(ia, 8, 8) * bitfieldExtract(ib, 8, 8) +
           bitfieldExtract(ia, 16, 8) * bitfieldExtract(ib, 16, 8) + bitfieldExtract(ia, 24, 8) * bitfieldExtract(ib, 24, 8);
#endif
}

void main()
{
    const uint numPixels = uint(OUT_H * OUT_W);
    const uint pixel     = gl_GlobalInvocationID.x;
    const int  ocBase    = int(gl_GlobalInvocationID.y) * 4;
    if (pixel >= numPixels || ocBase >= OUT_C)
        return;

    const int oy = int(pixel) / OUT_W;
    const int ox = int(pixel) - oy * OUT_W;

    const int numTaps    = KERNEL_H * KERNEL_W;
    const int icWords    = IC_WORDS;
    const int ocWords    = numTaps * icWords;  // weight words per output channel
    const int numOc      = min(4, OUT_C - ocBase);

    ivec4 acc = ivec4(0);
    for (int tap = 0; tap < numTaps; ++tap)
    {
        const int ky = tap / KERNEL_W;
        const int kx = tap - ky * KERNEL_W;
        const int vy = oy * STRIDE_Y - PAD_TOP + ky * DILATION_Y;
        const int vx = ox * STRIDE_X - PAD_LEFT + kx * DILATION_X;
        for (int w = 0; w < icWords; ++w)
        {
            const uint x   = FetchWord(vy, vx, w * 4);
            const int  wIx = tap * icWords + w;
            [[unroll]] for (int j = 0; j < 4; ++j)
            {
                if (j < numOc)
                    acc[j] += Dot4(x, weights[(ocBase + j) * ocWords + wIx]);
            }
        }
    }

    ivec4 r = ivec4(0);
    [[unroll]] for (int j = 0; j < 4; ++j)
    {
        if (j < numOc)
            r[j] = Epilogue(acc[j] + params[ocBase + j], ocBase + j);
    }
    dst[(pixel * uint(OUT_STRIDE) + uint(ocBase)) >> 2] = PackResult(r);
}
#endif
