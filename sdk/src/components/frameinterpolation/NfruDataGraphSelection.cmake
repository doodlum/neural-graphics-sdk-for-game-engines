#
# Resolves the NFRU data graph compiled into the SDK and its quantization parameters.
#
# Inputs:  FFX_NFRU_DATA_GRAPH_FILE      .vgf file (its stem names the generated g_<stem>_Info symbol)
#          FFX_NFRU_DATA_GRAPH_METADATA  model-gym export metadata (.json); empty selects <stem>_metadata.json
# Outputs: FFX_NFRU_DATA_GRAPH_NAME, FFX_NFRU_DATA_GRAPH_SELECTION_DIR containing
#          ffx_nfru_data_graph_selection.h (backend: graph blob) and ffx_nfru_data_graph_quant.h (component: quant).

if (NOT EXISTS "${FFX_NFRU_DATA_GRAPH_FILE}")
	message(FATAL_ERROR "FFX_NFRU_DATA_GRAPH_FILE does not exist: ${FFX_NFRU_DATA_GRAPH_FILE}")
endif()
get_filename_component(FFX_NFRU_DATA_GRAPH_NAME "${FFX_NFRU_DATA_GRAPH_FILE}" NAME_WLE)
get_filename_component(_nfru_graph_dir "${FFX_NFRU_DATA_GRAPH_FILE}" DIRECTORY)
if (NOT FFX_NFRU_DATA_GRAPH_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
	message(FATAL_ERROR "NFRU data graph file stem '${FFX_NFRU_DATA_GRAPH_NAME}' must be a valid C identifier")
endif()

set(_nfru_metadata "${FFX_NFRU_DATA_GRAPH_METADATA}")
if (NOT _nfru_metadata)
	set(_nfru_metadata "${_nfru_graph_dir}/${FFX_NFRU_DATA_GRAPH_NAME}_metadata.json")
endif()
if (NOT EXISTS "${_nfru_metadata}")
	message(FATAL_ERROR "NFRU data graph metadata not found: ${_nfru_metadata}. Export it with the model gym (keys inputs.x, "
		"outputs.getitem, outputs.getitem_1 with SINT/SNORM scale and zero_point) or set FFX_NFRU_DATA_GRAPH_METADATA.")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_nfru_metadata}")
file(READ "${_nfru_metadata}" _nfru_metadata_json)

function(_nfru_quant_value OUT_VAR)
	string(JSON _value ERROR_VARIABLE _error GET "${_nfru_metadata_json}" ${ARGN})
	if (_error)
		message(FATAL_ERROR "NFRU metadata ${_nfru_metadata}: missing ${ARGN} (${_error})")
	endif()
	set(${OUT_VAR} "${_value}" PARENT_SCOPE)
endfunction()

_nfru_quant_value(NFRU_Q_IN_SINT_SCALE      inputs x SINT scale)
_nfru_quant_value(NFRU_Q_IN_SINT_ZERO       inputs x SINT zero_point)
_nfru_quant_value(NFRU_Q_IN_SNORM_SCALE     inputs x SNORM scale)
_nfru_quant_value(NFRU_Q_IN_SNORM_ZERO      inputs x SNORM zero_point)
_nfru_quant_value(NFRU_Q_PARAMS_SINT_SCALE  outputs getitem SINT scale)
_nfru_quant_value(NFRU_Q_PARAMS_SINT_ZERO   outputs getitem SINT zero_point)
_nfru_quant_value(NFRU_Q_PARAMS_SNORM_SCALE outputs getitem SNORM scale)
_nfru_quant_value(NFRU_Q_PARAMS_SNORM_ZERO  outputs getitem SNORM zero_point)
_nfru_quant_value(NFRU_Q_GATE_SNORM_SCALE   outputs getitem_1 SNORM scale)
_nfru_quant_value(NFRU_Q_GATE_SNORM_ZERO    outputs getitem_1 SNORM zero_point)

message(STATUS "NFRU data graph: ${FFX_NFRU_DATA_GRAPH_FILE}")
message(STATUS "NFRU data graph metadata: ${_nfru_metadata}")

set(FFX_NFRU_DATA_GRAPH_SELECTION_DIR "${CMAKE_BINARY_DIR}/nfru_data_graph_selection")
file(MAKE_DIRECTORY "${FFX_NFRU_DATA_GRAPH_SELECTION_DIR}")
file(CONFIGURE OUTPUT "${FFX_NFRU_DATA_GRAPH_SELECTION_DIR}/ffx_nfru_data_graph_selection.h"
	CONTENT "// Generated by CMake from FFX_NFRU_DATA_GRAPH_FILE; do not edit.
#pragma once
#include <@FFX_NFRU_DATA_GRAPH_NAME@.h>
#define FFX_NFRU_DATA_GRAPH_INFO g_@FFX_NFRU_DATA_GRAPH_NAME@_Info
#define FFX_NFRU_DATA_GRAPH_NAME \"@FFX_NFRU_DATA_GRAPH_NAME@\"
"
	@ONLY)
file(CONFIGURE OUTPUT "${FFX_NFRU_DATA_GRAPH_SELECTION_DIR}/ffx_nfru_data_graph_quant.h"
	CONTENT "// Generated by CMake from @_nfru_metadata@; do not edit.
#pragma once
#define FFX_NFRU_DATA_GRAPH_NAME_QUANT \"@FFX_NFRU_DATA_GRAPH_NAME@\"
#define FFX_NFRU_QUANT_INPUT_SINT_SCALE (@NFRU_Q_IN_SINT_SCALE@)
#define FFX_NFRU_QUANT_INPUT_SINT_ZERO (@NFRU_Q_IN_SINT_ZERO@)
#define FFX_NFRU_QUANT_INPUT_SNORM_SCALE (@NFRU_Q_IN_SNORM_SCALE@)
#define FFX_NFRU_QUANT_INPUT_SNORM_ZERO (@NFRU_Q_IN_SNORM_ZERO@)
#define FFX_NFRU_QUANT_PARAMS_SINT_SCALE (@NFRU_Q_PARAMS_SINT_SCALE@)
#define FFX_NFRU_QUANT_PARAMS_SINT_ZERO (@NFRU_Q_PARAMS_SINT_ZERO@)
#define FFX_NFRU_QUANT_PARAMS_SNORM_SCALE (@NFRU_Q_PARAMS_SNORM_SCALE@)
#define FFX_NFRU_QUANT_PARAMS_SNORM_ZERO (@NFRU_Q_PARAMS_SNORM_ZERO@)
#define FFX_NFRU_QUANT_GATE_SNORM_SCALE (@NFRU_Q_GATE_SNORM_SCALE@)
#define FFX_NFRU_QUANT_GATE_SNORM_ZERO (@NFRU_Q_GATE_SNORM_ZERO@)
"
	@ONLY)
