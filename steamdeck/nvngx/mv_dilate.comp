#version 450
// Motion vector dilation for FSR (AISS_FSR_DILATE_MV / the plugin's "Dilate motion vectors"): each render pixel takes
// the motion vector of the nearest surface in its 3x3 neighbourhood, so thin foreground detail (foliage, wires, edges)
// moves with its own motion instead of the background's. Ties keep the centre: flat areas are passed through unchanged.
// SPDX-License-Identifier: MIT

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D u_depth;
layout(binding = 1) uniform sampler2D u_motion;
layout(binding = 2, rg32f) uniform writeonly image2D u_out;

layout(push_constant) uniform Push
{
    ivec2 size;      // render size
    int   inverted;  // 1: larger depth is nearer (reversed Z)
    int   pad;
} pc;

void main()
{
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size)))
        return;
    const float sign = pc.inverted != 0 ? 1.0 : -1.0;  // compare sign * depth: larger is nearer
    ivec2       best = p;
    float       bestKey = sign * texelFetch(u_depth, p, 0).r;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
        {
            const ivec2 q   = clamp(p + ivec2(x, y), ivec2(0), pc.size - 1);
            const float key = sign * texelFetch(u_depth, q, 0).r;
            if (key > bestKey)
            {
                bestKey = key;
                best    = q;
            }
        }
    imageStore(u_out, p, vec4(texelFetch(u_motion, best, 0).xy, 0.0, 0.0));
}
