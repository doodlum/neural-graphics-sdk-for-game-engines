#version 450
// Colour clean-up ahead of FSR 4 with auto exposure: FSR 4's auto exposure averages the whole frame's luminance, so a
// single Inf or NaN colour pixel (an overflowed highlight) makes the exposure non-finite and the whole output black
// until the next reset. Inf is clamped to the largest finite value of the output format, NaN becomes 0; every finite
// value passes through unchanged. Compiled once per float colour format (OUT_FORMAT: rgba16f, rgba32f,
// r11f_g11f_b10f) and written in the game's own format, so the pass costs no more bandwidth than the colour itself.
// SPDX-License-Identifier: MIT

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 1) uniform sampler2D u_color;
layout(binding = 2, OUT_FORMAT) uniform writeonly image2D u_out;

layout(push_constant) uniform Push
{
    ivec2 size;  // render size
    ivec2 pad;
} pc;

// The format names, defined only after the layout above has used OUT_FORMAT, give its largest finite value.
#define rgba16f        vec4(65504.0)
#define rgba32f        vec4(3.40282347e38)
#define r11f_g11f_b10f vec4(65024.0, 65024.0, 64512.0, 1.0)  // 11-bit / 10-bit unsigned float maxima
const vec4 kMax = OUT_FORMAT;

void main()
{
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size)))
        return;
    const vec4 c = texelFetch(u_color, p, 0);
    imageStore(u_out, p, mix(clamp(c, -kMax, kMax), vec4(0.0), isnan(c)));
}
