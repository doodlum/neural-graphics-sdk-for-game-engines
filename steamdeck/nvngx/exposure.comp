#version 450
// Log-average luminance of the game's colour input, for games that ask DLSS for auto exposure (NSS needs the colour
// pre-exposed: it tonemaps colour * exposure and quantises it to int8, so an unexposed dark HDR frame reaches the
// network as a handful of int8 levels and the history rejection fails, i.e. ghosting).
// One workgroup samples a regular grid (every `step` pixels) and writes {sum of log2 luminance, sample count, tag}.
// SPDX-License-Identifier: MIT

layout(local_size_x = 256) in;

layout(binding = 0) uniform sampler2D u_color;
layout(binding = 1, std430) buffer Result { vec4 slots[]; } u_result;

layout(push_constant) uniform Push
{
    ivec2 size;
    int   step;
    uint  slotAndTag;  // slot in the low 8 bits, frame tag above
} pc;

shared float s_sum[256];
shared float s_count[256];

void main()
{
    const uint  t     = gl_LocalInvocationID.x;
    const ivec2 grid  = (pc.size + pc.step - 1) / pc.step;
    const int   total = grid.x * grid.y;
    float sum = 0.0, count = 0.0;
    for (int i = int(t); i < total; i += 256)
    {
        const ivec2 p   = ivec2(i % grid.x, i / grid.x) * pc.step + pc.step / 2;
        const vec3  c   = texelFetch(u_color, min(p, pc.size - 1), 0).rgb;
        const float lum = dot(max(c, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        if (isinf(lum) || isnan(lum))
            continue;
        sum += log2(max(lum, 1.0 / 65536.0));
        count += 1.0;
    }
    s_sum[t]   = sum;
    s_count[t] = count;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1)
    {
        if (t < stride)
        {
            s_sum[t] += s_sum[t + stride];
            s_count[t] += s_count[t + stride];
        }
        barrier();
    }
    if (t == 0u)
        u_result.slots[pc.slotAndTag & 0xFFu] = vec4(s_sum[0], s_count[0], uintBitsToFloat(pc.slotAndTag >> 8), 0.0);
}
