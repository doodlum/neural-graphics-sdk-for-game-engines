#version 450
// Copies the game's depth (any depth or colour format) into the R32F image NSS samples.
// SPDX-License-Identifier: MIT

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D u_depth;
layout(binding = 1, r32f) uniform writeonly image2D u_out;

layout(push_constant) uniform Push
{
    ivec2 size;    // render size
    ivec2 offset;  // depth subrect base
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size)))
        return;
    imageStore(u_out, p, vec4(texelFetch(u_depth, p + pc.offset, 0).r));
}
