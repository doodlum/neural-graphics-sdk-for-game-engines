#version 450
// Copies the game's depth (any depth or colour format) into the R32F image NSS samples. A render subrect smaller than
// the context (dynamic resolution) is resampled nearest: depth is never blended across edges.
// SPDX-License-Identifier: MIT

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D u_depth;
layout(binding = 1, r32f) uniform writeonly image2D u_out;

layout(push_constant) uniform Push
{
    ivec2 size;    // context render size
    ivec2 offset;  // depth subrect base
    ivec2 src;     // depth subrect size
    ivec2 pad;
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size)))
        return;
    const ivec2 q = pc.src == pc.size ? p : min(ivec2((vec2(p) + 0.5) * (vec2(pc.src) / vec2(pc.size))), pc.src - 1);
    imageStore(u_out, p, vec4(texelFetch(u_depth, q + pc.offset, 0).r));
}
