#version 450
// Copies the (src) region at (offset) of a game input into an image of exactly (size), so NSS's UV-based reads
// (InvInputDims = 1 / renderSize) address the same texels as its texelFetch reads. When the game renders a smaller
// subrect than the NSS context was created for (dynamic resolution), the region is resampled up to the context size:
// bilinear for colour, nearest for motion vectors (blending motions across an edge invents motion no surface has).
// Equal sizes are a plain texel copy. Compiled once per output format
// (OUT_FORMAT: rgba16f, rgba32f, r11f_g11f_b10f, rgba8, rgb10_a2, rg16f, rg32f).
// SPDX-License-Identifier: MIT
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D u_src;
layout(binding = 1, OUT_FORMAT) uniform writeonly image2D u_out;
layout(push_constant) uniform Push
{
    ivec2 size;    // destination (context render) size
    ivec2 offset;  // source subrect base
    ivec2 src;     // source subrect size
    int   linear;  // 1: bilinear when resampling, 0: nearest
    int   pad;
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size)))
        return;
    if (pc.src == pc.size)
    {
        imageStore(u_out, p, texelFetch(u_src, p + pc.offset, 0));
        return;
    }
    const vec2  scale = vec2(pc.src) / vec2(pc.size);
    const ivec2 hi    = pc.src - 1;
    if (pc.linear == 0)
    {
        imageStore(u_out, p, texelFetch(u_src, min(ivec2((vec2(p) + 0.5) * scale), hi) + pc.offset, 0));
        return;
    }
    // Clamped to the subrect, so nothing outside the game's render area bleeds in at the right and bottom edges.
    const vec2  c  = (vec2(p) + 0.5) * scale - 0.5;
    const vec2  f  = fract(c);
    const ivec2 i0 = clamp(ivec2(floor(c)), ivec2(0), hi) + pc.offset;
    const ivec2 i1 = clamp(ivec2(floor(c)) + 1, ivec2(0), hi) + pc.offset;
    const vec4  top = mix(texelFetch(u_src, i0, 0), texelFetch(u_src, ivec2(i1.x, i0.y), 0), f.x);
    const vec4  bot = mix(texelFetch(u_src, ivec2(i0.x, i1.y), 0), texelFetch(u_src, i1, 0), f.x);
    imageStore(u_out, p, mix(top, bot, f.y));
}
