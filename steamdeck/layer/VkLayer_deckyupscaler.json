                    "vkGetImageViewHandleNVX",
                    "vkGetImageViewHandle64NVX",
                    "vkGetImageViewAddressNVX"
                ]
            },
            {
                "name": "VK_NV_low_latency2",
                "spec_version": "2",
                "entrypoints": [
                    "vkSetLatencySleepModeNV",
                    "vkLatencySleepNV",
                    "vkSetLatencyMarkerNV",
                    "vkGetLatencyTimingsNV",
                    "vkQueueNotifyOutOfBandNV"
