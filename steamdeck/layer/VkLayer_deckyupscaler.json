{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_DECKYUPSCALER",
        "type": "GLOBAL",
        "library_path": "./libVkLayer_deckyupscaler.so",
        "api_version": "1.3.0",
